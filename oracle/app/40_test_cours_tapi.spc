-- =====================================================================
-- 40_test_cours_tapi.spc
--
-- Specification du paquetage de tests utPLSQL de cours_tapi (suite
-- test_cours_tapi), reprise de « Lecon - 13 - Generation API/cours/
-- test/test_cours_tapi.pks ».
--
-- Prerequis : utPLSQL v3 installe dans le schema UT3 (synonymes publics)
-- et 30_cours.sql, 31_cours_tapi.spc et 31_cours_tapi.bdy deja joues.
--
-- Execute connecte AVEC LE COMPTE APPLICATIF, avant 40_test_cours_tapi.bdy :
--   docker compose exec oracle-db sqlplus "app3gb/<APP_USER_PASSWORD>@//localhost:1521/FREEPDB1" "@/sql/40_test_cours_tapi.spc"
-- =====================================================================

SET DEFINE OFF

Prompt Création du package spec de tests test_cours_tapi.
create or replace PACKAGE test_cours_tapi IS

   -- generated by utPLSQL for SQL Developer on 2023-11-03 14:36:02

   --%suite(test_cours_tapi)
   --%suitepath(alltests)
   --%rollback(manual)

   --%test(ins_cours normal: insertion d'un cours dans la table des cours)
    PROCEDURE ins_cours;

    --%test(ins_cours_null: insertion d'un cours dans la table des cours avec un nom null)
    PROCEDURE ins_cours_null;

    --%test(get_cours normal: extraction du cours inséré dans la table des cours)
    PROCEDURE get_cours;

    --%test(get_cours_inexistant: extraction du cours non présent dans la table des cours)
    PROCEDURE get_cours_inexistant;

   --%test(upd_cours: modification du cours inséré dans la table des cours)
    PROCEDURE upd_cours;

   --%test(upd_cours_inexistant: modification du cours inséré non présent dans la table des cours)
    PROCEDURE upd_cours_inexistant;

   --%test(del_cours normal: effacement du cours inséré dans la table des cours)
    PROCEDURE del_cours;

   --%test(del_cours_inexistant: effacement du cours inexistant dans la table des cours)
    PROCEDURE del_cours_inexistant;

END test_cours_tapi;
/
SHOW ERRORS;

EXIT;
