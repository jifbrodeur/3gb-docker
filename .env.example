# ---------------------------------------------------------------------
# Copier ce fichier en « .env » avant le premier demarrage :
#   macOS / Linux : cp .env.example .env
#   Windows       : copy .env.example .env
#
# Le fichier .env n'est JAMAIS versionne (voir .gitignore).
# ---------------------------------------------------------------------

# --- Oracle : comptes d'administration -------------------------------
# Mot de passe des comptes SYS et SYSTEM.
ORACLE_PASSWORD=Oracle3GB_2026

# --- Oracle : compte applicatif --------------------------------------
# Cree plus tard, a la main, par le script oracle/app/10_utilisateur.sql
APP_USER=app3gb
APP_USER_PASSWORD=App3GB_2026

# --- Ports publies sur le poste de l'etudiant ------------------------
# A changer seulement si le port est deja occupe sur votre machine.
ORACLE_PORT=1521
API_PORT=3010
WEB_PORT=8080
