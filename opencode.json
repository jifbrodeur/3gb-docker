{
  "$schema": "https://opencode.ai/config.json",
  "model": "vmlx/qwen3-coder",
  "enabled_providers": ["vmlx"],
  "providers": {
    "vmlx": {
      "name": "vMLX (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "qwen3-coder": {
          "modelID": "mlx-community/Qwen3-Coder-30B-A3B-Instruct-3bit",
          "name": "Qwen3 Coder 30B 3-bit (MLX)",
          "body": {
            "temperature": 0.7,
            "top_p": 0.8,
            "top_k": 20,
            "repetition_penalty": 1.05
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "write", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "bash", "resource": "*", "effect": "ask" },
    { "action": "execute", "resource": "*", "effect": "deny" },
    { "action": "opencode_*", "resource": "*", "effect": "deny" },
    { "action": "experimental_image_generate", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" }
  ]
}
